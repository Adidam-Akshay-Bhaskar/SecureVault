# ==========================================
# SecureVault Environment Configuration
# ==========================================
# SECURITY WARNING: This file contains sensitive credentials
# DO NOT commit this file to version control
# ==========================================

# Server Configuration
PORT=3000
NODE_ENV=development

# Database Configuration (PostgreSQL)
DB_HOST=your-database-host.com
DB_USER=your_db_username
DB_PASSWORD=your_db_password
DB_NAME=your_db_name
DB_PORT=5432

# AWS S3 Configuration
AWS_ACCESS_KEY_ID=YOUR_AWS_ACCESS_KEY_ID
AWS_SECRET_ACCESS_KEY=YOUR_AWS_SECRET_ACCESS_KEY
AWS_REGION=your-aws-region (e.g., ap-south-1)
S3_BUCKET_NAME=your-s3-bucket-name

# Security & Encryption
MASTER_SECRET=generate_a_random_hex_string_32_chars
JWT_SECRET=generate_a_random_jwt_secret_string
BCRYPT_ROUNDS=12

# Email Service Configuration (SMTP / Gmail App Passwords)
SYSTEM_EMAIL=your-system-notification-email@gmail.com
SYSTEM_EMAIL_PASS=your-gmail-app-specific-password

# API Configuration
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
MAX_FILE_SIZE=104857600
RATE_LIMIT_WINDOW=900000
RATE_LIMIT_MAX=100
